PORT=
NODE_ENV=
DATABASE_URL=postgresql://user:password@localhost:5432/workpulse
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Exact browser origins allowed to call this API with credentials.
# Comma-separated. Never a wildcard — CORS forbids "*" with credentials,
# and the web refresh cookie requires credentials.
WEB_ORIGINS=http://localhost:5173

# Refresh-cookie attributes for the web client. Secure must be true
# wherever the app is served over HTTPS. SameSite=none is only needed when
# the web app and API live on different registrable domains (and forces
# Secure=true); same-site deployments should stay on "lax".
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=.workpulse.example
